{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(python3 tools/log_summary.py *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl events *)",
      "Bash(kubectl config current-context)",
      "Bash(kubectl config get-contexts)",
      "Bash(kubectl auth can-i *)",
      "Write(reports/**)"
    ],
    "deny": [
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "Bash(kubectl apply *)",
      "Bash(kubectl create *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl replace *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl autoscale *)",
      "Bash(kubectl rollout *)",
      "Bash(kubectl set *)",
      "Bash(kubectl label *)",
      "Bash(kubectl annotate *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl cp *)",
      "Bash(kubectl port-forward *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl uncordon *)",
      "Bash(kubectl taint *)",
      "Bash(kubectl config use-context *)",
      "Bash(kubectl config set *)",
      "Bash(kubectl get secret *)",
      "Bash(kubectl get secrets *)",
      "Bash(kubectl describe secret *)",
      "Bash(helm *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(terraform *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/kubeconfig*)",
      "Read(~/.kube/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/readonly_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit_log.py\""
          }
        ]
      }
    ]
  }
}
